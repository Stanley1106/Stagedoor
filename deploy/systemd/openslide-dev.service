[Unit]
Description=open-slide dev server (editor, localhost only)
After=network-online.target
Wants=network-online.target

[Service]
User=slide
WorkingDirectory=/home/slide/deck
Environment=NODE_ENV=development
ExecStart=/usr/bin/npx --no-install open-slide dev --host 127.0.0.1 --port 5173 --no-skills-check
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
