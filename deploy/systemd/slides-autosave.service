# Commits slides/ to git about 30 seconds after edits settle (at most every
# 5 minutes while editing never stops). These commits are the versions on
# Stagedoor's History page.
[Unit]
Description=Stagedoor autosave (open-slide decks to git)
After=local-fs.target

[Service]
User=slide
WorkingDirectory=/home/slide/deck
Environment=QUIET=30 MAX_WAIT=300
ExecStart=/usr/local/bin/slides-autosave
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
